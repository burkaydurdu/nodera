                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}/node-pools/{poolID}/count": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "More Nodes are asked for (needs a payment method, 402, and a Team that is not suspended, 423); fewer releases the newest. 400 outside 1 and the limit; 403 without kubernetes.write.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Change a Node pool's count",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Node pool id",
                        "name": "poolID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "The count",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_aggregates_cluster.ResizeNodePoolRequest"
