{
    "swagger": "2.0",
    "info": {
        "description": "Kubernetes inside a Project: Clusters, their Node pools and Nodes, and Kubeconfigs. Prices are USD excluding taxes.",
        "title": "Nodera Kubernetes API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/v1/kubernetes/regions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "The Regions Kubernetes is sold in",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Region"
                            }
                        }
                    }
                }
            }
        },
        "/v1/kubernetes/regions/{region}/plans": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Plans with at least 2 CPUs and 4 GB of RAM; sold-out ones stay listed and flagged. 400 for a Region Kubernetes is not sold in.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "The Plans a Node may have in a Region, cheapest first",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Region code",
                        "name": "region",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Plan"
                            }
                        }
                    }
                }
            }
        },
        "/v1/kubernetes/versions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "The Kubernetes versions a Cluster may be opened with, newest first",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Version"
                            }
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "403 without kubernetes.read; 404 for a Project the caller is not a member of.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "A Project's Clusters",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The name is an RFC 1123 label unique in the Project (409 when taken). The Region must sell Kubernetes (400) and the version be offered (400); the first Node pool's Plan must be large enough for a Node (400) and in stock (409). Needs a payment method (402) and a Team that is not suspended (423); 403 without kubernetes.write. The Cluster is answered as provisioning; its Control plane and Nodes follow and arrive through detail.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Open a Cluster",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Name, Region, version and the first Node pool",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_aggregates_cluster.OpenRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "One Cluster with its Node pools",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Every Node is released and its Droplet deleted, then the Control plane goes; the Cluster is shown as deleting until then. Allowed whatever the Team's Billing status; 403 without kubernetes.write.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Delete a Cluster",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}/kubeconfig": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "A client certificate cut for the caller as cluster administrator; nothing is kept, so a removed member keeps it until it expires. 409 while the Control plane is not ready, being deleted or failed; 403 without kubernetes.write.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "A Kubeconfig for the caller, good for seven days",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Kubeconfig"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}/name": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The name is an RFC 1123 label unique in the Project (409 when taken); the Endpoint does not change. 409 for a Cluster being deleted or failed; 403 without kubernetes.write.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Rename a Cluster",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "The name",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_aggregates_cluster.RenameRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}/node-pools": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Name unique in the Cluster (409), Plan large enough for a Node (400) and in stock (409), count within the limit (400). Needs a payment method (402) and a Team that is not suspended (423); 409 for a Cluster being deleted or failed; 403 without kubernetes.write.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Add a Node pool",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Name, Plan, count, labels and taints",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_aggregates_cluster.NodePoolInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_kubernetes_application_dto.Cluster"
                        }
                    }
                }
            }
        },
        "/v1/projects/{projectID}/clusters/{clusterID}/node-pools/{poolID}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "A Cluster keeps at least one Node pool (409). 403 without kubernetes.write.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kubernetes"
                ],
                "summary": "Remove a Node pool and release its Nodes",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Cluster id",
                        "name": "clusterID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Node pool id",
                        "name": "poolID",
                        "in": "path",
                        "required": true
                    }
