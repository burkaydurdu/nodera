                        "type": "string",
                        "description": "Storage id",
                        "name": "storageID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Access key id",
                        "name": "accessKeyID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
