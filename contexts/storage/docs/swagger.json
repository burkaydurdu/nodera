                    {
                        "type": "string",
                        "description": "Storage id",
                        "name": "storageID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "The object key and whether it is public",
                        "name": "request",
                        "in": "body",
                        "required": true,
