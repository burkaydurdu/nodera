                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Storage id",
                        "name": "storageID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "A name and read or read_write",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_storage_aggregates_accesskey.CreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
