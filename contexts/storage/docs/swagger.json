                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "storage"
                ],
                "summary": "Open a Storage",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Bucket name, Region and Package",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_storage_aggregates_storage.OpenRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_storage_application_dto.Storage"
                        }
                    }
                }
            }
        },
