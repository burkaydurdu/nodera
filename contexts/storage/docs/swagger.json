{
    "swagger": "2.0",
    "info": {
        "description": "Storage inside a Project: Storages on Packages, their Access keys, files and usage. Sizes are bytes; prices are USD excluding taxes.",
        "title": "Nodera Storage API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
