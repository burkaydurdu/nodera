                ],
                "summary": "One Storage",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Storage id",
                        "name": "storageID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_storage_application_dto.Storage"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The request repeats the Bucket name (409 when it does not match). The Access keys stop and the Package ends at once; the files go shortly after, and the Storage is shown as deleting until they are gone. 403 without storage.write.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "storage"
                ],
                "summary": "Delete a Storage and everything in it",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "projectID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Storage id",
                        "name": "storageID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "The Storage's Bucket name, repeated",
                        "name": "bucket_name",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_piggystats_nodera_contexts_storage_application_dto.Storage"
                        }
                    }
                }
            }
        },
