environment = "dev"

[server]
name = "nodera-customer-gateway"
port = ":3460"

[redis]
host = "localhost"
port = 6389
username = ""
password = ""
db = 0

[secret]
jwt = "dev-jwt-secret-change-me"
session_key_format = "session:%s"

[cors]
allow_origins = ["http://localhost:3002", "http://localhost:*"]

[metrics]
enabled = false
port = ":9101"
