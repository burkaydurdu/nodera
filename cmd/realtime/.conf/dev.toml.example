# Copy to dev.toml (gitignored). Values match docker-compose.yml and cmd/customer/.conf/dev.toml.example.
environment = "dev"

[server]
name = "nodera-realtime"
port = ":9690"

# Sessions and permission versions the sockets are checked against, and the
# pub/sub channel the replicas share (docs/adr/0007).
[redis]
host = "localhost"
port = 6389
username = ""
password = ""
db = 0

[rabbitmq]
host = "127.0.0.1:5682"
username = "guest"
password = "guest"
virtualhost = "/nodera"
auth_secret = "dev-rabbitmq-auth-secret"

# The same JWT secret the customer service signs access tokens with.
[secret]
jwt = "dev-jwt-secret-change-me"

# origin_patterns are the web app's origins (scheme://host, path.Match
# patterns); a page on any other site cannot open a socket.
[websocket]
origin_patterns = ["http://localhost:3002", "http://localhost:*"]
heartbeat_seconds = 25
auth_timeout_seconds = 5

[metrics]
enabled = false
port = ":9105"
