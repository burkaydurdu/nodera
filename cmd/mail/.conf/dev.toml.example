# Copy to dev.toml (gitignored). Values match docker-compose.yml and cmd/customer/.conf/dev.toml.example.
environment = "dev"

# The management API sits behind the customer gateway, the sending API behind
# the integration gateway; only KumoMTA reaches the internal API.
[server]
name = "nodera-mail"
port = ":9700"
sending_port = ":9701"
internal_port = ":9702"

# In dev the relay generates a self-signed certificate when none is given.
[smtp]
hostname = "smtp.nodera.local"
submission_addr = ":1587"
tls_addr = ":1465"
alt_addr = ":2525"
cert_file = ""
key_file = ""
max_message_bytes = 10485760

# The zone the Sending domains' CNAMEs point at (docs/adr/0011). An empty
# resolver checks domains with the system's.
[dns]
listen_addr = ":5354"
zone = "mta.nodera.local"
nameservers = ["ns1.mta.nodera.local"]
hostmaster = "hostmaster.nodera.local"
mx_hosts = ["mx.mta.nodera.local"]
spf = "v=spf1 ip4:127.0.0.1 -all"
addresses = ["mx.mta.nodera.local=127.0.0.1", "ns1.mta.nodera.local=127.0.0.1"]
refresh_seconds = 30
resolver = ""

# KumoMTA's injection API; its policy accepts these credentials.
[mta]
injection_url = "http://localhost:8010/api/inject/v1"
username = "mail-service"
password = "dev-mta-password"
timeout_seconds = 30

# What KumoMTA presents to the internal API.
[internal]
token = "dev-mail-internal-token"

[postgresql]
uri = "postgres://postgres:postgres@localhost:5442/nodera_mail?sslmode=disable"

[postgresql.pool]
max_conns = 8
min_conns = 0
max_conn_idle_seconds = 120
max_conn_lifetime_seconds = 1800
health_check_period_seconds = 60

[redis]
host = "localhost"
port = 6389
username = ""
password = ""
db = 0

# The outbox lives here and nothing else does (docs/adr/0001).
[mongodb]
host = "localhost"
port = 27027
username = ""
password = ""
database = "nodera_mail_outbox"
uri = "mongodb://localhost:27027/?directConnection=true"

[rabbitmq]
host = "127.0.0.1:5682"
username = "guest"
password = "guest"
virtualhost = "/nodera"
auth_secret = "dev-rabbitmq-auth-secret"

# The same JWT secret the customer service signs access tokens with; the
# encryption key (32 bytes, base64) seals DKIM keys and Webhook secrets.
[secret]
jwt = "dev-jwt-secret-change-me"
encryption_key = "ZGV2LW1haWwtZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM="

[webhooks]
allow_local = true

[jobs]
domain_check_seconds = 60
rotation_minutes = 60
rollover_minutes = 15
dispatch_seconds = 5
days_minutes = 30
rates_minutes = 15
webhooks_seconds = 5
expire_minutes = 60

[metrics]
enabled = false
port = ":9106"
