environment = "dev"

# The Inbox API.
[server]
name = "nodera-notification"
port = ":9680"

# Notifications and the Team read model (docs/adr/0008).
[postgresql]
uri = "postgres://postgres:postgres@localhost:5442/nodera_notification?sslmode=disable"

[postgresql.pool]
max_conns = 4
min_conns = 0
max_conn_idle_seconds = 120
max_conn_lifetime_seconds = 1800
health_check_period_seconds = 60

# Sessions, checked by the Inbox API.
[redis]
host = "localhost"
port = 6389
username = ""
password = ""
db = 0

# The same JWT secret the customer service signs access tokens with.
[secret]
jwt = "dev-jwt-secret-change-me"

[rabbitmq]
host = "127.0.0.1:5682"
username = "guest"
password = "guest"
virtualhost = "/nodera"
auth_secret = "dev-rabbitmq-auth-secret"

[mail]
from = "no-reply@nodera.local"
from_name = "Nodera"
templates_dir = "./templates/notification"
provider = "smtp"

[smtp]
insecure_skip_verify = true
host = "localhost"
port = 1035
username = ""
password = ""

[sendgrid]
api_key = ""

[metrics]
enabled = false
port = ":9102"
