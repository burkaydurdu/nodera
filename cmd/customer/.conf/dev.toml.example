# Copy to dev.toml (gitignored). Values match docker-compose.yml.
environment = "dev"

[server]
name = "nodera-customer"
port = ":9650"

[postgresql]
uri = "postgres://postgres:postgres@localhost:5432/nodera_customer?sslmode=disable"

[postgresql.pool]
max_conns = 4
min_conns = 0
max_conn_idle_seconds = 120
max_conn_lifetime_seconds = 1800
health_check_period_seconds = 60

[redis]
host = "localhost"
port = 6379
username = ""
password = ""
db = 0

[mongodb]
host = "localhost"
port = 27017
username = ""
password = ""
database = "nodera_customer_outbox"
uri = "mongodb://localhost:27017/?directConnection=true"

[rabbitmq]
host = "127.0.0.1:5672"
username = "guest"
password = "guest"
virtualhost = "/nodera"
auth_secret = "dev-rabbitmq-auth-secret"

[secret]
jwt = "dev-jwt-secret-change-me"

[auth]
access_ttl_minutes = 15
refresh_ttl_days = 30
dev_code = "123456"

[domain]
front = "http://localhost:3002"

[metrics]
enabled = false
port = ":9100"
